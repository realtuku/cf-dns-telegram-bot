# Telegram bot token from @BotFather
TELEGRAM_TOKEN=123456789:AAExampleTokenReplaceMe

# Cloudflare API Token (Zone:Read + DNS:Edit on your zones)
CF_API_TOKEN=your_cloudflare_api_token

# Comma-separated Telegram chat IDs allowed to use the bot
# Get yours from @userinfobot
ALLOWED_CHAT_IDS=123456789

# Optional — Render injects PORT automatically
PORT=8080
